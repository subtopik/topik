{
  "name": "@topik/codemod",
  "version": "0.1.0-alpha.5",
  "description": "Codemods for migrating content to Topik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subtopik/topik.git",
    "directory": "packages/codemod"
  },
  "bin": {
    "topik-codemod": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@drizzle-team/brocli": "catalog:",
    "@topik/content": "workspace:*",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-frontmatter": "catalog:",
    "micromark-extension-frontmatter": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "micromark-util-types": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "inlinedDependencies": {
    "devlop": "1.1.0",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-chunked": "2.0.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-normalize-identifier": "2.0.1",
    "micromark-util-resolve-all": "2.0.1"
  }
}
