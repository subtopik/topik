{
  "name": "@topik/content-react",
  "version": "0.1.0-alpha.8",
  "description": "React renderer for declarative Topik content",
  "keywords": [
    "content",
    "documentation",
    "markdown",
    "react",
    "renderer",
    "topik"
  ],
  "homepage": "https://github.com/subtopik/topik/tree/main/packages/content-react#readme",
  "bugs": {
    "url": "https://github.com/subtopik/topik/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subtopik/topik.git",
    "directory": "packages/content-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./preview-assets": "./dist/preview-assets.mjs",
    "./rich": "./dist/rich.mjs",
    "./theme": "./dist/theme.mjs",
    "./package.json": "./package.json",
    "./rich/styles.css": "./dist/rich/styles.css",
    "./theme/styles.css": "./dist/theme/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/copy-styles.mjs",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "vp test --config .storybook/vite.config.mjs",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@topik/content": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "^28.1.0",
    "katex": "^0.19.1",
    "pele": "catalog:",
    "playwright": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "storybook": "^10.6.7",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "katex": "^0.18.2 || ^0.19.1",
    "pele": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "pele": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
