{
  "name": "@topik/core",
  "version": "0.1.0-alpha.8",
  "description": "Topik core library",
  "keywords": [
    "compiler",
    "content",
    "course",
    "documentation",
    "markdown",
    "topik",
    "wiki"
  ],
  "homepage": "https://github.com/subtopik/topik/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/subtopik/topik/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subtopik/topik.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./course-navigation": "./dist/course-navigation.mjs",
    "./preview": "./dist/preview.mjs",
    "./wiki-navigation": "./dist/wiki-navigation.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/copy-licenses.mjs",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@topik/content": "workspace:*",
    "@topik/schema": "workspace:*",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "chokidar": "^6.0.0",
    "yaml": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
