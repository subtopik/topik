{
  "name": "@topik/schema",
  "version": "0.1.0-alpha.5",
  "description": "JSON Schema definitions for Topik resources",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subtopik/topik.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.json": "./dist/*.json",
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run generate && vp pack",
    "check:generated": "node scripts/generate-types.mjs --check",
    "dev": "vp run generate && vp pack --watch",
    "generate": "node scripts/generate-types.mjs",
    "test": "vp test",
    "check": "vp run check:generated && vp check src scripts package.json vite.config.mjs",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "^2.9.0"
  }
}
