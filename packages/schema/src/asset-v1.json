{
  "$id": "https://topik.dev/schemas/asset/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The digest in spec.uri must equal the digest suffix in spec.integrity; use hasMatchingAssetDigests after structural validation.",
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "v1" },
    "name": {
      "pattern": "^auto-v1-[a-z2-7]{51}[aq]$",
      "type": "string"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "integrity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "mediaType": {
          "enum": [
            "application/gzip",
            "application/octet-stream",
            "application/pdf",
            "application/zip",
            "audio/flac",
            "audio/mpeg",
            "audio/ogg",
            "audio/wav",
            "image/avif",
            "image/bmp",
            "image/gif",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/x-icon",
            "video/mp4"
          ],
          "type": "string"
        },
        "size": {
          "maximum": 268435456,
          "minimum": 0,
          "type": "integer"
        },
        "uri": {
          "pattern": "^blobs/[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": ["uri", "integrity", "size", "mediaType"],
      "type": "object"
    },
    "type": { "const": "Asset" }
  },
  "required": ["apiVersion", "type", "name", "spec"],
  "title": "Topik Asset v1",
  "type": "object"
}
