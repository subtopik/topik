{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topik.dev/schemas/person/v1.json",
  "title": "Person",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "v1"
    },
    "type": {
      "type": "string",
      "const": "Person"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 63
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": ["string", "null"],
          "maxLength": 320,
          "format": "email"
        },
        "bio": {
          "type": ["string", "null"]
        }
      },
      "required": ["name"],
      "additionalProperties": false
    }
  },
  "required": ["apiVersion", "type", "name", "spec"],
  "additionalProperties": false
}
