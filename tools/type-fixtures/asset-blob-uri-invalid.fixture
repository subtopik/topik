import type { AssetBlobUri } from "@topik/core";
import type { AssetSpec } from "@topik/schema/asset/v1";

// @ts-expect-error even a canonical-looking literal requires runtime admission
const uncheckedLiteral: AssetBlobUri =
  "blobs/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
const generalAssetUri: AssetSpec["uri"] = "https://cdn.example.com/asset";
// @ts-expect-error digest alphabet is lowercase hexadecimal only
const alphabet: AssetBlobUri =
  "blobs/gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg";
// @ts-expect-error uppercase hexadecimal is noncanonical
const uppercase: AssetBlobUri =
  "blobs/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
// @ts-expect-error prefix is exact
const prefix: AssetBlobUri =
  "blob/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
// @ts-expect-error the removed layout has no type-level compatibility path
const legacy: AssetBlobUri =
  "assets/sha256/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";

const uncheckedString: string =
  "blobs/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
// @ts-expect-error unchecked strings must pass the runtime parser or guard
const unchecked: AssetBlobUri = uncheckedString;

void [uncheckedLiteral, generalAssetUri, alphabet, uppercase, prefix, legacy, unchecked];
