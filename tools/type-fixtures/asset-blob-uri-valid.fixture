import {
  isAssetBlobUri,
  parseAssetBlobUri,
  parseGeneratedAssetName,
  type AssetBlobUri,
  validateAssetBlobUri,
  type AssetCompilationResult,
} from "@topik/core";
import type { Asset } from "@topik/schema/asset/v1";

const parsed: AssetBlobUri = parseAssetBlobUri(
  "blobs/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
);
const asset: Asset = {
  apiVersion: "v1",
  type: "Asset",
  name: parseGeneratedAssetName("auto-v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
  spec: {
    uri: parsed,
    integrity: "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    mediaType: "application/octet-stream",
    size: 0,
  },
};

const candidate: unknown = parsed;
if (isAssetBlobUri(candidate)) {
  const narrowed: AssetBlobUri = candidate;
  void narrowed;
}

const coreValidation = validateAssetBlobUri(String(parsed));
if (coreValidation.ok) {
  const coreUri: AssetBlobUri = coreValidation.value.uri;
  void coreUri;
}

declare const compilation: AssetCompilationResult;
for (const resource of compilation.resources) {
  if (resource.type === "Asset") {
    const compilerUri: string = resource.spec.uri;
    void compilerUri;
  }
}
for (const payload of compilation.payloads) {
  const compilerPayloadPath: AssetBlobUri = payload.path;
  void compilerPayloadPath;
}

void asset;
